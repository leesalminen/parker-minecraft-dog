{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "gx:swirl",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/gx_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": "variable.size * 1.6",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.life"
      },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.2,
        "rotation_acceleration": 220.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * 0.5",
          "variable.size * 0.5"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            224,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color.r",
          "variable.color.g",
          "variable.color.b",
          "variable.color.a * (1.0 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
