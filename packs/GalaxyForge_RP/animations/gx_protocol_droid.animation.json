            "0"
          ]
        }
      }
    },
    "animation.gx_protocol_droid.attack": {
      "loop": false,
      "bones": {
        "arm_l_up": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -55",
            "0",
            "0"
          ]
        },
        "arm_r_up": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -55",
            "0",
            "0"
          ]
        },
        "arm_l_fore": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -35",
            "0",
            "0"
          ]
        },
        "arm_r_fore": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -35",
            "0",
            "0"
          ]
        },
        "torso": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 10",
            "0",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -8",
            "0",
            "0"
          ]
        }
      }
    }
  }
}
