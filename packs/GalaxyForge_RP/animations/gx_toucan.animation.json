{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_toucan.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 70 + 0) * 45 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 70 + 180) * 45 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "body": {
          "position": [
            "0",
            "math.abs(math.sin(query.modified_distance_moved * 70)) * 1.5 * query.modified_move_speed * 3",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 70 + 0) * 5 * query.modified_move_speed",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_toucan.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 80) * 0.15",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 50) * 5",
            "math.sin(query.life_time * 26) * 22",
            "math.sin(query.life_time * 19) * 6"
          ]
        },
        "wing_l": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 100 + 0) * 3"
          ]
        },
        "wing_r": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 100 + 3.1) * 3"
          ]
        }
      }
    }
  }
}
