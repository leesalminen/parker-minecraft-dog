{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_astro_droid.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 45 + 0) * 24 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 45 + 180) * 24 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_c": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 45 + 90) * 18 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "body": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.modified_distance_moved * 22) * 7 * query.modified_move_speed"
          ]
        },
        "arm_up": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 45 + 180) * 8 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "holo": {
          "rotation": [
            "0",
            "math.sin(query.life_time * 90) * 25",
            "0"
          ]
        }
      }
    },
    "animation.gx_astro_droid.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 45) * 0.6",
            "0"
          ],
          "rotation": [
            "math.sin(query.life_time * 40) * 1.5",
            "0",
            "0"
          ]
        },
        "arm_up": {
          "rotation": [
            "math.sin(query.life_time * 40 + 0) * 4",
            "0",
            "0"
          ]
        },
        "arm_fore": {
          "rotation": [
            "math.sin(query.life_time * 40 + 1.2) * 3",
            "0",
            "0"
          ]
        },
        "holo": {
          "rotation": [
            "0",
            "math.sin(query.life_time * 55) * 30",
            "0"
          ]
        },
        "eye": {
          "position": [
            "0",
            "0",
            "math.sin(query.life_time * 80) * 0.15"
          ]
        },
        "leg_c": {
          "rotation": [
            "-10",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_astro_droid.attack": {
      "loop": false,
      "bones": {
        "arm_up": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -70",
            "0",
            "0"
          ]
        },
        "arm_fore": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -45",
            "0",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 12",
            "0",
            "0"
          ]
        },
        "body": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 5",
            "0",
            "0"
          ]
        }
      }
    }
  }
}
