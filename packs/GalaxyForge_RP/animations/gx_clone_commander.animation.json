{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_clone_commander.walk": {
      "loop": true,
      "bones": {
        "thigh_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 40 + 0) * 38 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "thigh_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 40 + 180) * 38 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "shin_l": {
          "rotation": [
            "math.max(0, math.cos(query.modified_distance_moved * 40 + 180)) * 30 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "shin_r": {
          "rotation": [
            "math.max(0, math.cos(query.modified_distance_moved * 40)) * 30 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "pelvis": {
          "position": [
            "0",
            "math.abs(math.sin(query.modified_distance_moved * 40 / 2)) * 0.9 * query.modified_move_speed",
            "0"
          ]
        },
        "torso": {
          "rotation": [
            "0",
            "math.cos(query.modified_distance_moved * 40) * 5 * query.modified_move_speed",
            "0"
          ]
        }
      }
    },
    "animation.gx_clone_commander.idle": {
      "loop": true,
      "bones": {
        "torso": {
          "rotation": [
            "math.sin(query.life_time * 28 + 0) * 1.5",
            "0",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 40) * 2",
            "math.sin(query.life_time * 22) * 14",
            "0"
          ]
        }
      }
    },
    "animation.gx_clone_commander.attack": {
      "loop": false,
      "bones": {
        "arm_r_up": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -20",
            "0",
            "0"
          ]
        },
        "rifle": {
          "position": [
            "0",
            "0",
            "math.sin(variable.attack_time * 180) * 2"
          ]
        },
        "torso": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -3",
            "0",
            "0"
          ]
        }
      }
    }
  }
}
