{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_moss_golem.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 28 + 0) * 22 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 28 + 180) * 22 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 28 + 180) * 16 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 28 + 0) * 16 * query.modified_move_speed",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_moss_golem.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 80) * 0.4",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 70 + 0) * 4"
          ]
        },
        "arm_r": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 70 + 3.1) * 4"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 40) * 3",
            "math.sin(query.life_time * 22) * 14",
            "0"
          ]
        }
      }
    }
  }
}
