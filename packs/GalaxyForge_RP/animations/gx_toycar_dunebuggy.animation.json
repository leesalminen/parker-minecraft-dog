{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_toycar_dunebuggy.roll": {
      "loop": true,
      "bones": {
        "wheel_fl": {
          "rotation": [
            "query.modified_distance_moved * 262.3",
            "0",
            "0"
          ]
        },
        "wheel_fr": {
          "rotation": [
            "query.modified_distance_moved * 262.3",
            "0",
            "0"
          ]
        },
        "wheel_rl": {
          "rotation": [
            "query.modified_distance_moved * 205.3",
            "0",
            "0"
          ]
        },
        "wheel_rr": {
          "rotation": [
            "query.modified_distance_moved * 205.3",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_toycar_dunebuggy.move": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 1500) * 0.3",
            "0"
          ],
          "rotation": [
            "math.sin(query.life_time * 1100) * 0.9 - query.modified_move_speed * 3",
            "0",
            "math.sin(query.life_time * 830) * 0.8"
          ]
        }
      }
    },
    "animation.gx_toycar_dunebuggy.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 200) * 0.06",
            "0"
          ],
          "rotation": [
            "math.sin(query.life_time * 120) * 0.4",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_toycar_dunebuggy.fx": {
      "loop": true,
      "bones": {
        "flame_l": {
          "scale": [
            "1",
            "1",
            "query.modified_move_speed > 0.02 ? (0.7 + 0.5 * math.sin(query.life_time * 2600)) : 0.2"
          ]
        },
        "flame_r": {
          "scale": [
            "1",
            "1",
            "query.modified_move_speed > 0.02 ? (0.7 + 0.5 * math.sin(query.life_time * 3000)) : 0.2"
          ]
        }
      }
    }
  }
}
