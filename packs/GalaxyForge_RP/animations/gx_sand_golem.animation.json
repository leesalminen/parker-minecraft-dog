{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_sand_golem.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 0) * 28 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 180) * 28 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 180) * 12 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 0) * 12 * query.modified_move_speed",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_sand_golem.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 80) * 0.4",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.sin(query.life_time * 60 + 0) * 6",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.sin(query.life_time * 60 + 2) * 6",
            "0",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 50) * 2",
            "math.sin(query.life_time * 27) * 12",
            "0"
          ]
        }
      }
    }
  }
}
