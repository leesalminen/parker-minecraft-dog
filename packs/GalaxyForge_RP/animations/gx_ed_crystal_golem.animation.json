{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_ed_crystal_golem.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 0) * 26 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 180) * 26 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 180) * 20 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 0) * 20 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 100) * 0.6",
            "0"
          ]
        }
      }
    },
    "animation.gx_ed_crystal_golem.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 40) * 0.3",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 35 + 0.0) * 4"
          ]
        },
        "arm_r": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 35 + 1.0) * -4"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 25) * 3",
            "math.sin(query.life_time * 17) * 12",
            "0"
          ]
        }
      }
    },
    "animation.gx_ed_crystal_golem.attack": {
      "loop": false,
      "bones": {
        "arm_l": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -100",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * -100",
            "0",
            "0"
          ]
        }
      }
    }
  }
}
