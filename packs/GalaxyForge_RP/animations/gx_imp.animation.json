{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_imp.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 60 + 0) * 35 * query.modified_move_speed",
