            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 60 + 180) * 35 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 60 + 180) * 28.0 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 60 + 0) * 28.0 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "wing_l": {
          "rotation": [
            "0",
            "0",
            "-40 + math.sin(query.life_time * 200) * 6"
          ]
        },
        "wing_r": {
          "rotation": [
            "0",
            "0",
            "40 - math.sin(query.life_time * 200) * 6"
          ]
        }
      }
    },
    "animation.gx_imp.idle": {
      "loop": true,
      "bones": {
