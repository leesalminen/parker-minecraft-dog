        "wing_r": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 380) * 40 * -1"
          ]
        },
        "tail": {
          "rotation": [
            "0",
            "math.sin(query.life_time * 70 + 0) * 20",
