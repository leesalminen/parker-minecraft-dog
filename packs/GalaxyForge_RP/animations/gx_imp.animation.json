          ]
        },
        "arm_l": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 70 + 0) * 4"
          ]
        },
        "arm_r": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 70 + 3.1) * 4"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 60) * 3",
            "math.sin(query.life_time * 33) * 8",
            "0"
          ]
        },
        "tail": {
          "rotation": [
            "0",
            "math.sin(query.life_time * 70 + 0) * 20",
            "0"
          ]
        },
        "wing_l": {
          "rotation": [
            "0",
            "0",
            "-40 + math.sin(query.life_time * 240) * 8"
          ]
        },
        "wing_r": {
          "rotation": [
            "0",
            "0",
            "40 - math.sin(query.life_time * 240) * 8"
          ]
        }
      }
