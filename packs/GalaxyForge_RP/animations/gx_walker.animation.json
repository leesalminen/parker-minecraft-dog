{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_walker.walk": {
      "loop": true,
      "bones": {
        "thigh_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 0) * 24 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "thigh_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 180) * 24 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "shin_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 180) * 20 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "shin_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42) * 20 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "foot_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 90) * 12 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "foot_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42 + 270) * 12 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "body": {
          "position": [
            "0",
            "math.abs(math.sin(query.modified_distance_moved * 21)) * 0.9 * query.modified_move_speed",
            "0"
          ],
          "rotation": [
            "0",
            "0",
            "math.cos(query.modified_distance_moved * 21) * 3 * query.modified_move_speed"
          ]
        },
        "neck": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 42) * 2 * query.modified_move_speed",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_walker.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 60) * 0.55",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 42 + 0) * 3.5",
            "0",
            "0"
          ]
        },
        "antenna": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 110 + 0.6) * 12"
          ]
        },
        "neck": {
          "rotation": [
            "math.sin(query.life_time * 50) * 1.5",
            "0",
            "0"
          ]
        },
        "cannon_l": {
          "rotation": [
            "math.sin(query.life_time * 70) * 1.5",
            "0",
            "0"
          ]
        },
        "cannon_r": {
          "rotation": [
            "math.sin(query.life_time * 70 + 1.3) * 1.5",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_walker.attack": {
      "loop": false,
      "bones": {
        "cannon_l": {
          "position": [
            "0",
            "0",
            "math.sin(variable.attack_time * 180) * 2.2"
          ]
        },
        "cannon_r": {
          "position": [
            "0",
            "0",
            "math.sin(variable.attack_time * 180) * 2.2"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 7",
            "0",
            "0"
          ]
        },
        "body": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 4",
            "0",
            "0"
          ]
        },
        "antenna": {
          "rotation": [
            "0",
            "0",
            "math.sin(variable.attack_time * 180) * -18"
          ]
        }
      }
    }
  }
}
