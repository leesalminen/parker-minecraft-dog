{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_yeti.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 0) * 26 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 180) * 26 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 180) * 22 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 30 + 0) * 22 * query.modified_move_speed",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_yeti.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 80) * 0.5",
            "0"
          ],
          "rotation": [
            "math.sin(query.life_time * 50) * 1.5 + 3",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.sin(query.life_time * 50) * 3",
            "0",
            "6"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.sin(query.life_time * 50 + 3) * 3",
            "0",
            "-6"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 60) * 3",
            "math.sin(query.life_time * 33) * 8",
            "0"
          ]
        }
      }
    },
    "animation.gx_yeti.attack": {
      "loop": false,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 18",
            "0",
            "0"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(variable.attack_time * 180) * 12",
            "0",
            "0"
          ]
        }
      }
    }
  }
}
