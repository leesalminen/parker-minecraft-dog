{
  "format_version": "1.8.0",
  "animations": {
    "animation.gx_crystal_golem.walk": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 32 + 0) * 24 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 32 + 180) * 24 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 32 + 180) * 18 * query.modified_move_speed",
            "0",
            "0"
          ]
        },
        "arm_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 32 + 0) * 18 * query.modified_move_speed",
            "0",
            "0"
          ]
        }
      }
    },
    "animation.gx_crystal_golem.idle": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            "0",
            "math.sin(query.life_time * 80) * 0.3",
            "0"
          ]
        },
        "arm_l": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 70 + 0) * 4"
          ]
        },
        "arm_r": {
          "rotation": [
            "0",
            "0",
            "math.sin(query.life_time * 70 + 3.1) * 4"
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 40) * 3",
            "math.sin(query.life_time * 25) * 10",
            "0"
          ]
        }
      }
    }
  }
}
