        "attack": "animation.gx_drake.attack",
        "look": "animation.common.look_at_target"
      },
      "scripts": {
        "scale": "1.0",
        "animate": [
          "look",
          {
            "flap": "query.modified_move_speed < 0.02"
          },
          {
            "walk": "query.modified_move_speed > 0.02"
          },
          "idle",
          "attack"
        ]
      },
      "render_controllers": [
        "controller.render.gx_drake"
      ],
      "spawn_egg": {
        "base_color": "#3f4676",
        "overlay_color": "#7fe8ff"
      }
    }
