{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "gx:drake",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/gx_drake"
      },
      "geometry": {
        "default": "geometry.gx_drake"
      },
      "animations": {
        "flap": "animation.gx_drake.flap",
