        "idle": "animation.gx_car.idle"
      },
      "scripts": {
        "scale": "1.0",
        "animate": [
          {
            "move": "query.modified_move_speed > 0.02"
          },
          "idle"
        ]
      },
      "render_controllers": [
        "controller.render.gx_car"
      ],
      "spawn_egg": {
        "base_color": "#2f8fe0",
        "overlay_color": "#ffe27a"
      }
    }
  }
}
