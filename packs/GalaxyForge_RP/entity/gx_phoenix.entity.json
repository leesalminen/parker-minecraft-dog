{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "gx:phoenix",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/gx_phoenix"
      },
      "geometry": {
        "default": "geometry.gx_phoenix"
      },
      "animations": {
        "walk": "animation.gx_phoenix.walk",
        "idle": "animation.gx_phoenix.idle",
        "flap": "animation.gx_phoenix.flap",
        "look": "animation.common.look_at_target"
      },
      "scripts": {
        "scale": "1.3",
        "animate": [
          "look",
          {
            "walk": "query.modified_move_speed > 0.02 && query.is_on_ground"
          },
          {
            "flap": "!query.is_on_ground"
          },
          "idle"
        ]
      },
      "render_controllers": [
        "controller.render.gx_phoenix"
      ],
      "spawn_egg": {
        "base_color": "#ff7a1a",
        "overlay_color": "#ffd23a"
      }
    }
  }
}
